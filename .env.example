# ==========================================
# Salaar Pallet Solutions - Environment Configuration
# ==========================================

# Database: Neon Serverless PostgreSQL connection string (pooled connection recommended for serverless)
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require"

# Auth: 32+ character random secret string for JWT cookie signing
SESSION_SECRET="generate-a-secure-32-byte-secret-key-here"

# AI / Chatbot: Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# Admin Seed Credentials (used by prisma/seed.ts)
ADMIN_EMAIL="admin@salaarpallets.com"
ADMIN_PASSWORD="SecureAdminPassword123!"
